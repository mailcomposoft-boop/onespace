---
// Графика первого экрана «Документы и медиа» — свёрстана кодом, в CMS не редактируется.
---
<div style="background:#fff;border:1px solid #E3E8F1;border-radius:18px;padding:24px;box-shadow:0 18px 44px rgba(11,29,58,.09)">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">
    <div style="font-family:'Manrope',sans-serif;font-weight:700;font-size:14px">Каталог бренд-материалов 2026</div>
    <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#5B6B8C;background:#F1F4F9;padding:5px 9px;border-radius:999px">8 312 файла</div>
  </div>
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px">
    <div style="aspect-ratio:1;border-radius:12px;background:repeating-linear-gradient(135deg,#EEF3FA,#EEF3FA 6px,#F8FAFD 6px,#F8FAFD 12px);border:1px solid #E3E8F1;display:flex;align-items:flex-end;padding:10px;animation:osPop .45s ease-out both;animation-delay:.05s"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#5B6B8C">JPG</span></div>
    <div style="aspect-ratio:1;border-radius:12px;background:repeating-linear-gradient(135deg,#E8F1FF,#E8F1FF 6px,#F5F9FF 6px,#F5F9FF 12px);border:1px solid #CADFFB;display:flex;align-items:flex-end;padding:10px;animation:osPop .45s ease-out both;animation-delay:.1s"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#0052B4">MP4</span></div>
    <div style="aspect-ratio:1;border-radius:12px;background:repeating-linear-gradient(135deg,#EEF3FA,#EEF3FA 6px,#F8FAFD 6px,#F8FAFD 12px);border:1px solid #E3E8F1;display:flex;align-items:flex-end;padding:10px;animation:osPop .45s ease-out both;animation-delay:.15s"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#5B6B8C">PSD</span></div>
    <div style="aspect-ratio:1;border-radius:12px;background:repeating-linear-gradient(135deg,#EEF3FA,#EEF3FA 6px,#F8FAFD 6px,#F8FAFD 12px);border:1px solid #E3E8F1;display:flex;align-items:flex-end;padding:10px;animation:osPop .45s ease-out both;animation-delay:.2s"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#5B6B8C">PDF</span></div>
    <div style="aspect-ratio:1;border-radius:12px;background:repeating-linear-gradient(135deg,#EEF3FA,#EEF3FA 6px,#F8FAFD 6px,#F8FAFD 12px);border:1px solid #E3E8F1;display:flex;align-items:flex-end;padding:10px;animation:osPop .45s ease-out both;animation-delay:.25s"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#5B6B8C">PNG</span></div>
    <div style="aspect-ratio:1;border-radius:12px;background:repeating-linear-gradient(135deg,#EEF3FA,#EEF3FA 6px,#F8FAFD 6px,#F8FAFD 12px);border:1px solid #E3E8F1;display:flex;align-items:flex-end;padding:10px;animation:osPop .45s ease-out both;animation-delay:.3s"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#5B6B8C">JPG</span></div>
    <div style="aspect-ratio:1;border-radius:12px;background:repeating-linear-gradient(135deg,#E8F1FF,#E8F1FF 6px,#F5F9FF 6px,#F5F9FF 12px);border:1px solid #CADFFB;display:flex;align-items:flex-end;padding:10px;animation:osPop .45s ease-out both;animation-delay:.35s"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#0052B4">MP4</span></div>
    <div style="aspect-ratio:1;border-radius:12px;border:1px dashed #CADFFB;background:#F8FAFD;display:flex;align-items:center;justify-content:center;animation:osPop .45s ease-out both;animation-delay:.4s"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#8B96AD">+8 304</span></div>
  </div>
  <div style="display:flex;align-items:center;gap:10px;margin-top:18px;padding:13px 15px;background:#E4F8ED;border:1px solid #CBEEDA;border-radius:12px">
    <span style="width:8px;height:8px;border-radius:50%;background:#0EA968;animation:osPulse 2.4s infinite"></span>
    <span style="font-size:12.5px;color:#0B1D3A">AI разметил теги и нашёл 214 дублей</span>
  </div>
</div>
