---
// Графика первого экрана «Регламенты и знания» — свёрстана кодом, в CMS не редактируется.
---
<div style="background:#fff;border:1px solid #E3E8F1;border-radius:18px;padding:24px;box-shadow:0 18px 44px rgba(11,29,58,.09)">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <div style="font-family:'Manrope',sans-serif;font-weight:700;font-size:14px">База знаний · WIKI</div>
    <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#5B6B8C;background:#F1F4F9;padding:5px 9px;border-radius:999px">412 документа</div>
  </div>
  <div style="display:flex;flex-direction:column;gap:8px">
    <div style="display:flex;align-items:center;gap:12px;background:#E8F1FF;border:1px solid #CADFFB;border-radius:11px;padding:13px 15px;animation:osPop .45s ease-out both;animation-delay:.1s">
      <span style="width:8px;height:8px;border-radius:50%;background:#0077FF"></span>
      <span style="font-size:13.5px;font-weight:600;flex:1">Регламенты</span>
      <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#0052B4">14 разделов</span>
    </div>
    <div style="display:flex;align-items:center;gap:12px;background:#FBFCFE;border:1px solid #E9EEF7;border-radius:11px;padding:13px 15px;margin-left:26px;animation:osPop .45s ease-out both;animation-delay:.2s">
      <span style="font-size:13.5px;flex:1">Информационная безопасность</span>
      <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#0EA968;background:#E4F8ED;padding:3px 8px;border-radius:999px">v3.2 актуально</span>
    </div>
    <div style="display:flex;align-items:center;gap:12px;background:#FBFCFE;border:1px solid #E9EEF7;border-radius:11px;padding:13px 15px;margin-left:26px;animation:osPop .45s ease-out both;animation-delay:.28s">
      <span style="font-size:13.5px;flex:1">Приёмка на складе</span>
      <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8B96AD">v1.8</span>
    </div>
    <div style="display:flex;align-items:center;gap:12px;background:#FBFCFE;border:1px solid #E9EEF7;border-radius:11px;padding:13px 15px;animation:osPop .45s ease-out both;animation-delay:.36s">
      <span style="width:8px;height:8px;border-radius:50%;background:#D89A1E"></span>
      <span style="font-size:13.5px;font-weight:600;flex:1">Онбординг · маршрут</span>
      <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#5B6B8C">9 шагов</span>
    </div>
  </div>
  <div style="margin-top:20px;padding-top:18px;border-top:1px solid #E9EEF7">
    <div style="display:flex;justify-content:space-between;font-size:12px;color:#5B6B8C;margin-bottom:8px"><span>Новый сотрудник прошёл</span><span style="font-family:'IBM Plex Mono',monospace;color:#0B1D3A">6 из 9</span></div>
    <div style="height:8px;border-radius:999px;background:#E9EEF7;overflow:hidden"><div style="height:100%;width:67%;border-radius:999px;background:#0077FF;transform-origin:left;animation:osGrowX 1.1s cubic-bezier(.2,.8,.2,1) both;animation-delay:.45s"></div></div>
  </div>
</div>
