---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/blog/PostCard.astro';
import site from '../../content/site.json';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base seo={{ title: `${site.blog.title} — Compo OneSpace`, description: site.blog.description }} active="/blog" extraCss="/styles/blog.css">
  <section class="os-sec os-sec--first">
    <div class="os-kicker os-kicker--pill">Compo OneSpace</div>
    <h1 class="os-h1">{site.blog.title}</h1>
    <p class="os-lead">{site.blog.description}</p>
    {tags.length > 0 && (
      <div class="bl-tags">{tags.map((t) => <a class="bl-tag" href={`/blog/tag/${encodeURIComponent(t)}`}>{t}</a>)}</div>
    )}
  </section>

  <section class="os-sec os-sec--last">
    {posts.length
      ? <div class="bl-grid">{posts.map((p) => <PostCard post={p} />)}</div>
      : <div class="bl-empty">Статей пока нет. Первая появится, как только её опубликуют в админке.</div>}
  </section>
</Base>
