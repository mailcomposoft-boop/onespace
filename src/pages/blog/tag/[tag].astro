---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/blog/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()) }
  }));
}
const { tag, posts } = Astro.props;
---
<Base seo={{ title: `${tag} — блог Compo OneSpace`, description: `Статьи по теме «${tag}»` }} active="/blog" extraCss="/styles/blog.css">
  <section class="os-sec os-sec--first">
    <a class="bl-back" href="/blog">← Все статьи</a>
    <h1 class="os-h1">{tag}</h1>
  </section>
  <section class="os-sec os-sec--last">
    <div class="bl-grid">{posts.map((p) => <PostCard post={p} />)}</div>
  </section>
</Base>
