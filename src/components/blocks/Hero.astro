---
import HeroAi from '../graphics/HeroAi.astro';
import { linkHref } from '../../lib/link.js';

const {
  kicker, h1, lead, audience, chips = [], graphic = 'none', image = '',
  cta_primary, cta_primary_action = 'popup:demo', cta_primary_url = '',
  cta_secondary, cta_secondary_action = '#instrument', cta_secondary_url = ''
} = Astro.props;
// Графика справа: свёрстанная кодом (по ключу) или картинка из CMS
const GRAPHICS = { ai: HeroAi };
const Graphic = GRAPHICS[graphic];
---
<section class="os-sec os-sec--first">
  <div class:list={[{ 'os-split': Graphic || image }]}>
    <div>
      {kicker && <div class="os-kicker os-kicker--pill">{kicker}</div>}
      <h1 class="os-h1">{h1}</h1>
      {lead && <p class="os-lead">{lead}</p>}
      {audience && (
        <div class="os-audience">
          <div class="os-audience__cap">Кому это будет полезно</div>
          <div class="os-audience__text">{audience}</div>
        </div>
      )}
      <div class="os-btnrow">
        {cta_primary && <a class="os-btn" href={linkHref(cta_primary_action, cta_primary_url)}>{cta_primary} →</a>}
        {cta_secondary && <a class="os-btn os-btn--ghost" href={linkHref(cta_secondary_action, cta_secondary_url, '#instrument')}>{cta_secondary}</a>}
      </div>
      {chips.length > 0 && <div class="os-chips">{chips.map((c) => <span class="os-chip">{c}</span>)}</div>}
    </div>
    {Graphic ? <Graphic /> : image && <img src={image} alt="" style="width:100%;height:auto;border-radius:18px;display:block" />}
  </div>
</section>
