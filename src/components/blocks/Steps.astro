---
const { title, items = [] } = Astro.props;
const n = (i) => String(i + 1).padStart(2, '0');
---
<section class="os-sec os-reveal" data-block="08">
  <div class="os-kicker">Как начать</div>
  <h2 class="os-h2" style="margin-bottom:40px">{title}</h2>
  <div style="position:relative">
    <div class="os-dash"></div>
    <div class="os-g3" style="position:relative">
      {items.map((it, i) => {
        const accent = i === 1;
        return (
          <div class:list={['os-card', { 'os-card--accent': accent }]}>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">
              <span class="os-mono" style={`font-size:12px;font-weight:700;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;${accent ? 'color:#fff;background:#0077FF' : 'color:#0077FF;background:#E8F1FF'}`}>{n(i)}</span>
              <span class="os-mono" style={`font-size:11px;color:${accent ? '#0052B4' : '#8B96AD'}`}>{it.time}</span>
            </div>
            <div class="os-h3">{it.title}</div>
            <div class="os-text">{it.text}</div>
          </div>
        );
      })}
    </div>
  </div>
</section>
