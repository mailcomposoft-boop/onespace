---
// Графика первого экрана «Единый контур» — свёрстана кодом, в CMS не редактируется.
---
<div style="background:#fff;border:1px solid #E3E8F1;border-radius:18px;padding:26px;box-shadow:0 18px 44px rgba(11,29,58,.09)">
  <div style="display:grid;grid-template-columns:1fr 54px 1fr;gap:12px;align-items:center">
    <div>
      <div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:#8B96AD;margin-bottom:12px">Сейчас</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        <span style="font-size:12px;font-weight:600;padding:7px 11px;border-radius:999px;background:#F1F4F9;color:#5B6B8C;animation:osPop .4s ease-out both;animation-delay:.05s">Jira</span>
        <span style="font-size:12px;font-weight:600;padding:7px 11px;border-radius:999px;background:#F1F4F9;color:#5B6B8C;animation:osPop .4s ease-out both;animation-delay:.1s">Confluence</span>
        <span style="font-size:12px;font-weight:600;padding:7px 11px;border-radius:999px;background:#F1F4F9;color:#5B6B8C;animation:osPop .4s ease-out both;animation-delay:.15s">Excel</span>
        <span style="font-size:12px;font-weight:600;padding:7px 11px;border-radius:999px;background:#F1F4F9;color:#5B6B8C;animation:osPop .4s ease-out both;animation-delay:.2s">Google Drive</span>
        <span style="font-size:12px;font-weight:600;padding:7px 11px;border-radius:999px;background:#F1F4F9;color:#5B6B8C;animation:osPop .4s ease-out both;animation-delay:.25s">Мессенджер</span>
        <span style="font-size:12px;font-weight:600;padding:7px 11px;border-radius:999px;background:#F1F4F9;color:#5B6B8C;animation:osPop .4s ease-out both;animation-delay:.3s">DAM-сервис</span>
        <span style="font-size:12px;font-weight:600;padding:7px 11px;border-radius:999px;background:#F1F4F9;color:#5B6B8C;animation:osPop .4s ease-out both;animation-delay:.35s">Внешний AI</span>
        <span style="font-size:12px;font-weight:600;padding:7px 11px;border-radius:999px;background:#F1F4F9;color:#5B6B8C;animation:osPop .4s ease-out both;animation-delay:.4s">Тайм-трекер</span>
      </div>
    </div>
    <div style="height:2px;background-image:linear-gradient(90deg,#CADFFB 55%,transparent 55%);background-size:11px 2px;animation:osDash 1.1s linear infinite"></div>
    <div style="background:linear-gradient(135deg,#0077FF,#0052B4);border-radius:16px;padding:20px 16px;text-align:center;box-shadow:0 14px 30px rgba(0,119,255,.28)">
      <div style="font-family:'Manrope',sans-serif;font-weight:800;font-size:15px;color:#fff;margin-bottom:14px">OneSpace</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center">
        <span style="width:28px;height:28px;border-radius:8px;background:#fff;color:#0052B4;font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;animation:osPop .4s ease-out both;animation-delay:.45s">T</span>
        <span style="width:28px;height:28px;border-radius:8px;background:#fff;color:#0052B4;font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;animation:osPop .4s ease-out both;animation-delay:.5s">F</span>
        <span style="width:28px;height:28px;border-radius:8px;background:#fff;color:#0052B4;font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;animation:osPop .4s ease-out both;animation-delay:.55s">K</span>
        <span style="width:28px;height:28px;border-radius:8px;background:#fff;color:#0052B4;font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;animation:osPop .4s ease-out both;animation-delay:.6s">D</span>
        <span style="width:28px;height:28px;border-radius:8px;background:#fff;color:#0052B4;font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;animation:osPop .4s ease-out both;animation-delay:.65s">O</span>
        <span style="width:28px;height:28px;border-radius:8px;background:rgba(255,255,255,.22);color:#fff;font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;animation:osPop .4s ease-out both;animation-delay:.7s">AI</span>
      </div>
      <div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:rgba(255,255,255,.8);margin-top:14px">один контур</div>
    </div>
  </div>
  <div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:24px;padding-top:18px;border-top:1px solid #E9EEF7">
    <span style="font-size:12.5px;color:#5B6B8C">Договоров, обновлений и точек утечки</span>
    <span style="font-family:'IBM Plex Mono',monospace;font-size:16px;font-weight:700"><span style="color:#8B96AD">8</span> → <span style="color:#0077FF">1</span></span>
  </div>
</div>
