---
// Графика первого экрана «Проекты и маржа» — свёрстана кодом, в CMS не редактируется.
---
<div style="position:relative">
  <div style="background:#fff;border:1px solid #E3E8F1;border-radius:18px;padding:22px;box-shadow:0 18px 44px rgba(11,29,58,.09)">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">
      <div style="font-family:'Manrope',sans-serif;font-weight:700;font-size:14px">Проект «Север» · Трекер</div>
      <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#0EA968;background:#E4F8ED;padding:5px 9px;border-radius:999px">62% закрыто</div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
      <div style="background:#FBFCFE;border:1px solid #E9EEF7;border-radius:12px;padding:12px;animation:osPop .5s ease-out both;animation-delay:.1s">
        <div style="font-size:11px;font-weight:600;color:#8B96AD;margin-bottom:10px">Backlog · 12</div>
        <div style="background:#fff;border:1px solid #E3E8F1;border-radius:9px;padding:9px;margin-bottom:7px"><div style="font-family:'IBM Plex Mono',monospace;font-size:10px;color:#0077FF">FE-104</div><div style="font-size:12px;font-weight:500;margin-top:3px">Интеграция SSO</div></div>
        <div style="background:#fff;border:1px solid #E3E8F1;border-radius:9px;padding:9px"><div style="font-family:'IBM Plex Mono',monospace;font-size:10px;color:#0077FF">QA-087</div><div style="font-size:12px;font-weight:500;margin-top:3px">Регресс RBAC</div></div>
      </div>
      <div style="background:#FBFCFE;border:1px solid #E9EEF7;border-radius:12px;padding:12px;animation:osPop .5s ease-out both;animation-delay:.2s">
        <div style="font-size:11px;font-weight:600;color:#8B96AD;margin-bottom:10px">В работе · 5</div>
        <div style="background:#fff;border:1px solid #CADFFB;border-radius:9px;padding:9px;margin-bottom:7px;animation:osFloatY 4s ease-in-out infinite"><div style="font-family:'IBM Plex Mono',monospace;font-size:10px;color:#0077FF">PM-021</div><div style="font-size:12px;font-weight:500;margin-top:3px">Договор «Север»</div></div>
        <div style="background:#fff;border:1px solid #E3E8F1;border-radius:9px;padding:9px"><div style="font-family:'IBM Plex Mono',monospace;font-size:10px;color:#0077FF">DAM-015</div><div style="font-size:12px;font-weight:500;margin-top:3px">Каталог Q2</div></div>
      </div>
      <div style="background:#FBFCFE;border:1px solid #E9EEF7;border-radius:12px;padding:12px;animation:osPop .5s ease-out both;animation-delay:.3s">
        <div style="font-size:11px;font-weight:600;color:#8B96AD;margin-bottom:10px">Готово · 28</div>
        <div style="background:#fff;border:1px solid #E3E8F1;border-radius:9px;padding:9px"><div style="font-family:'IBM Plex Mono',monospace;font-size:10px;color:#0EA968">KB-301</div><div style="font-size:12px;font-weight:500;margin-top:3px">Регламент онбординга</div></div>
      </div>
    </div>
  </div>
  <div style="background:linear-gradient(135deg,#0B1D3A,#14294F);border-radius:16px;padding:20px 22px;margin-top:-14px;margin-left:34px;position:relative;box-shadow:0 18px 40px rgba(11,29,58,.22);animation:osRise .7s ease-out both;animation-delay:.35s">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:14px">
      <div><div style="font-size:11px;color:#AFC2E8;margin-bottom:5px">Потрачено</div><div style="font-family:'IBM Plex Mono',monospace;font-size:22px;font-weight:700;color:#fff">8.42м ₽</div></div>
      <div style="text-align:right"><div style="font-size:11px;color:#AFC2E8;margin-bottom:5px">Прогноз</div><div style="font-family:'IBM Plex Mono',monospace;font-size:22px;font-weight:700;color:#fff">11.6м ₽</div></div>
    </div>
    <div style="height:8px;border-radius:999px;background:rgba(255,255,255,.14);overflow:hidden"><div style="height:100%;width:73%;border-radius:999px;background:#4DA2FF;transform-origin:left;animation:osGrowX 1.1s cubic-bezier(.2,.8,.2,1) both;animation-delay:.5s"></div></div>
    <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#FFB4A1;margin-top:10px">Перерасход +6% · backend MVP</div>
  </div>
</div>
